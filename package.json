{
  "name": "times-camp",
  "version": "0.0.1",
  "description": "TimeTrack — saída de equipes de campo (GERE/GOMAN/GSTC)",
  "productName": "TimeTrack",
  "author": "CGB Engenharia",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:api": "bun run scripts/dev-server.ts",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:all": "bun run typecheck && bun run typecheck:api",
    "seed": "bun run scripts/seed.ts",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@quasar/extras": "^2.0.3",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "cookie": "0.6.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "pinia": "^4.0.2",
    "quasar": "^2.24.0",
    "vue": "^3.5.22",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.5.0",
    "@types/bun": "^1.3.14",
    "@types/cookie": "0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@vercel/node": "^5.9.7",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}