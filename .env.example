# URL de conexão do Neon (Postgres). Pegue em console.neon.tech > Connection Details
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require

# Segredo usado para assinar o JWT de sessão. Gere um valor aleatório longo.
JWT_SECRET=troque-por-um-valor-aleatorio-bem-grande

# Opcional: usados só pelo `bun run seed` para criar o primeiro admin
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
ADMIN_NOME=Administrador
